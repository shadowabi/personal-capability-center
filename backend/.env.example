# AI Memory Dashboard - Backend Configuration

# Database Configuration
AI_MEMORY_HOST=localhost
AI_MEMORY_PORT=5432
AI_MEMORY_DB=ai_memory
AI_MEMORY_USER=ai_user
AI_MEMORY_PASSWORD=ai_password_123

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO

# OpenCode API Configuration (Monthly/Yearly Summary)
OPENCODE_API_URL=http://127.0.0.1:4096

# OpenCode Agent Configuration
# 复制 backend/.env.example 为 backend/.env.local 并填入你的实际配置
# .env.local 会被 .gitignore 忽略，不会上传到 GitHub
AGENT_NAME=thought-framework
MODEL_ID=glm-4.7
PROVIDER_ID=zai-coding-plan

SUMMARY_TIMEOUT=30
MAX_CONVERSATIONS=50
MAX_DETAIL_LENGTH=800

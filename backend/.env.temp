# AI Memory Dashboard - Backend Configuration

# Database Configuration
# backend uses host network, so it must use host port
AI_MEMORY_HOST=localhost
AI_MEMORY_PORT=5433
AI_MEMORY_DB=ai_memory
AI_MEMORY_USER=ai_user
AI_MEMORY_PASSWORD=ai_password_123

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Logging
LOG_LEVEL=INFO

# OpenCode API Configuration (Monthly/Yearly Summary)
# Use the Docker network gateway to access host services
OPENCODE_API_URL=http://127.0.0.1:4096
AGENT_NAME=thought-framework  # Optional: Your custom agent name
SUMMARY_TIMEOUT=30
MAX_CONVERSATIONS=50
MAX_DETAIL_LENGTH=800
